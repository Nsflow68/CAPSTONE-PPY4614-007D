// Prisma schema for Mi Refugio NestJS backend.
// Defines the initial PostgreSQL data model to mirror the FastAPI domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(uuid())
  email     String        @unique
  name      String
  password  String
  avatarUrl String?
  role      String        @default("member")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  diaryEntries  DiaryEntry[]
  hydrationLogs HydrationLog[]
}

model DiaryEntry {
  id        String   @id @default(uuid())
  title     String
  content   String
  mood      String
  score     Int
  moodText  String?
  date      DateTime
  createdAt DateTime  @default(now())
  emotions  String[]
  tags      String[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model HydrationLog {
  id        String   @id @default(uuid())
  date      DateTime
  amountMl  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Resource {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String
  coverage      String?
  contactPhone  String?
  contactEmail  String?
  website       String?
  region        String?
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
