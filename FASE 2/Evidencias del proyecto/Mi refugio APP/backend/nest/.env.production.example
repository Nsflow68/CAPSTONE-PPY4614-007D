# Mi Refugio Backend - NestJS - Production Environment
# Copy this file to .env.production and fill with your production values

PORT=3001
NODE_ENV=production

# PostgreSQL Database (AWS RDS recommended)
DATABASE_URL=postgresql://username:password@production-db.aws.com:5432/mirefugio?schema=mobile

# JWT Authentication (CRITICAL: Use strong secrets in production)
JWT_SECRET=CHANGE-THIS-TO-VERY-STRONG-SECRET-MINIMUM-32-CHARS
JWT_EXPIRES_IN=1h

# Chatbot / LLM Local or Remote
OLLAMA_BASE_URL=https://llm-production.mirefugio.cl
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
CHATBOT_TIMEOUT_MS=15000
CHATBOT_RETRIES=2

# Demo / Seeds (disable in production)
DEMO_USER_EMAIL=

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGINS=https://mirefugio.cl,https://www.mirefugio.cl
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
