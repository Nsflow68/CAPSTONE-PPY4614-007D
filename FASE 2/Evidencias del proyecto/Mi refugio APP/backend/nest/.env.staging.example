# Mi Refugio Backend - NestJS - Staging Environment
# Copy this file to .env.staging and fill with your staging values

PORT=3001
NODE_ENV=staging

# PostgreSQL Database (AWS/local)
# Usa el schema mobile por defecto y acceso a web.auth_user si es necesario
# Ejemplo: postgresql://user:password@host:5432/db?schema=mobile
DATABASE_URL=postgresql://mirefugio:mirefugio@localhost:5432/mirefugio?schema=mobile

# JWT Authentication
JWT_SECRET=change-this-to-strong-secret-staging
JWT_EXPIRES_IN=1h

# Chatbot / LLM Local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
CHATBOT_TIMEOUT_MS=10000
CHATBOT_RETRIES=1

# Demo / Seeds
DEMO_USER_EMAIL=invitado@mirefugio.cl

# Logging
LOG_LEVEL=debug
