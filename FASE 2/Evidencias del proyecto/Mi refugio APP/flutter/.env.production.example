# Mi Refugio APP - Flutter Mobile - Production Environment
# Copy this file to .env.production and fill with your production values

# API Configuration
API_BASE_URL=https://api.mirefugio.cl/api
API_TIMEOUT_SECONDS=30
API_LOGGING=false

# LLM / Chatbot
OLLAMA_BASE_URL=https://llm.mirefugio.cl
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_DEBUG_MODE=false

# Google Sign In
GOOGLE_CLIENT_ID=your-production-google-client-id
