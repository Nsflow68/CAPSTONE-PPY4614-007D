PORT=3001
NODE_ENV=development

# PostgreSQL (AWS/local). Usa el schema mobile por defecto y acceso a web.auth_user
# Ejemplo: postgresql://user:password@host:5432/db?schema=mobile
DATABASE_URL=postgresql://user:password@localhost:5432/mirefugio?schema=mobile

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# Chatbot / IA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
CHATBOT_TIMEOUT_MS=10000
CHATBOT_RETRIES=1

# Demo / seeds
DEMO_USER_EMAIL=invitado@mirefugio.cl
