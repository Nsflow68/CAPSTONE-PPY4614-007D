// Prisma schema for Mi Refugio NestJS backend.
// Defines the initial PostgreSQL data model to mirror the FastAPI domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(uuid())
  email     String        @unique
  name      String
  password  String
  avatarUrl String?
  role      String        @default("member")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  diaryEntries  DiaryEntry[]
  hydrationLogs HydrationLog[]
}

model DiaryEntry {
  id        String   @id @default(uuid())
  title     String
  content   String
  mood      String
  score     Int
  moodText  String?
  date      DateTime
  createdAt DateTime  @default(now())
  emotions  String[]
  tags      String[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model HydrationLog {
  id        String   @id @default(uuid())
  date      DateTime
  amountMl  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Resource {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String
  coverage      String?
  contactPhone  String?
  contactEmail  String?
  website       String?
  region        String?
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Refuge {
  id          String   @id @default(uuid())
  name        String
  description String
  address     String
  phone       String?
  email       String?
  website     String?
  capacity    Int      @default(0)
  occupied    Int      @default(0)
  region      String
  commune     String?
  latitude    Float?
  longitude   Float?
  services    String[]
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adoptions   Adoption[]
}

model Adoption {
  id          String   @id @default(uuid())
  petName     String
  petType     String
  petBreed    String?
  petAge      Int?
  petGender   String?
  description String
  imageUrl    String?
  status      String   @default("available")
  adoptedBy   String?
  adoptedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refuge      Refuge   @relation(fields: [refugeId], references: [id], onDelete: Cascade)
  refugeId    String
}
