/* ----------------------------------------------------
   Estilos QSS para "Mi Refugio ERP"
   ---------------------------------------------------- */

/* Estilo Base de la Ventana */
QMainWindow {
    background-color: #F8F4F0; /* Color beige claro para el fondo principal */
}

/* -----------------------------------
   1. Sidebar (Navegación Principal)
   ----------------------------------- */
#MainContainer {
    background-color: #F8F4F0;
}

#SidebarUserCard {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 16px;
}

#SidebarRoleLabel {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

#SidebarInfoLabel {
    color: rgba(255, 255, 255, 0.75);
    font-size: 12px;
}

#SidebarDivider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    margin: 4px 20px 12px 20px;
}

#SidebarLogoutButton {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    padding: 12px 20px;
    margin: 0 20px;
    border-radius: 10px;
}

#SidebarLogoutButton:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

#SidebarLogoutButton:pressed {
    background-color: rgba(255, 255, 255, 0.28);
}

#LoginStatusLabel {
    color: #d9534f;
    min-height: 20px;
}

#SidebarWidget {
    background-color: #A28FC9; /* Morado base */
    border-right: 1px solid #7B68AD;
}

#SidebarWidget QPushButton {
    background-color: transparent;
    border: none;
    font-size: 15px;
    text-align: left;
    padding: 14px 24px;
    color: #ffffff;
    border-radius: 10px;
}

#SidebarWidget QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

#SidebarWidget QPushButton:checked {
    background-color: rgba(0, 0, 0, 0.22);
    font-weight: 600;
}

/* -----------------------------------
   2. Sub-Pestañas
   ----------------------------------- */
QPushButton#TabBarButton {
    font-size: 14px;
    padding: 10px 15px;
    border: 1px solid #E0E0E0;
    border-bottom: none;
    background-color: #F0F0F0;
    color: #4A4A4A;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QPushButton#TabBarButton:checked {
    background-color: #fff;
    color: #333;
    border-top: 2px solid #A28FC9;
    font-weight: bold;
    border-bottom: 1px solid white;
}

/* -----------------------------------
   3. Elementos Comunes y Formularios
   ----------------------------------- */

QDialog {
    background-color: #ffffff;
    border-radius: 12px;
}

QDialog QLabel {
    color: #4A4A4A;
}

QDialog QPushButton {
    background-color: #A28FC9;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 22px;
    font-weight: 600;
}

QDialog QPushButton:hover {
    background-color: #7B68AD;
}

QDialog QPushButton:pressed {
    background-color: #5C4B82;
}

QGroupBox {
    font-weight: bold;
    margin-top: 10px;
    padding-top: 20px;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #4A4A4A;
}

/* -----------------------------------
   CAMPOS DE FORMULARIO
   ----------------------------------- */
QLineEdit, QTextEdit, QComboBox {
    padding: 8px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: #ffffff;
    color: #000000;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #A28FC9;
    outline: none;
}

/* -----------------------------------
   COMBOBOX — FIX COMPLETO
   ----------------------------------- */

/* Vista desplegable */
QComboBox QAbstractItemView {
    background-color: #ffffff;   /* Fondo visible */
    color: #000000;              /* Texto negro */
    border: 1px solid #ccc;
    selection-background-color: #E8E3F5;
    selection-color: #000000;
}

/* Ítems */
QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    color: #000000;
    background-color: #ffffff;
}

/* Hover */
QComboBox QAbstractItemView::item:hover {
    background-color: #E8E3F5;   /* Morado suave */
    color: #000000;
}

/* Seleccionado */
QComboBox QAbstractItemView::item:selected {
    background-color: #D9D0F0;
    color: #000000;
}

/* Compatibilidad global con vistas de lista/tabla */
QAbstractItemView {
    color: #000000;
    background-color: #ffffff;
    selection-background-color: #E8E3F5;
    selection-color: #000000;
}

QListView::item, QTreeView::item {
    color: #000000;
    background-color: #ffffff;
    padding: 6px 10px;
}

QListView::item:hover, QTreeView::item:hover {
    background-color: #E8E3F5;
    color: #000000;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: #D9D0F0;
    color: #000000;
}

/* -----------------------------------
   4. Botones (CRUD y Exportación)
   ----------------------------------- */
QPushButton {
    padding: 8px 15px;
    border-radius: 4px;
    border: none;
    font-weight: 500;
}

/* Botón de Éxito */
#AddButton, #SuccessButton {
    background-color: #5cb85c; 
    color: white;
}

/* Botón de Advertencia */
#DeleteButton, #DangerButton {
    background-color: #d9534f; 
    color: white;
}

/* Acción Principal */
#PrimaryActionButton {
    background-color: #A28FC9; 
    color: white;
    font-weight: bold;
}

/* Exportación */
#InfoButton {
    background-color: #5bc0de;
    color: white;
}

/* -----------------------------------
   5. Tablas y Listas
   ----------------------------------- */
QTableView {
    selection-background-color: #D1C4E9; /* Morado claro */
    selection-color: black;
    border: 1px solid #E0E0E0;
    gridline-color: #F0F0F0;
}

QListWidget {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
}
/* ----------------------------------------------------
   FIX UNIVERSAL: ELIMINAR ICONOS AUTOMÁTICOS DE BOTONES
   ---------------------------------------------------- */

/* Eliminar iconos por defecto en TODOS los botones */
QPushButton {
    qproperty-icon: none;
    qproperty-iconSize: 0px;
}

/* Evitar que macOS o Qt muestren iconos por defecto (líneas/barras) */
QPushButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}

/* Evitar iconos automáticos en botones default (macOS principalmente) */
QPushButton:default {
    qproperty-icon: none;
    qproperty-iconSize: 0px;
}

/* Evitar iconos en botones checkables (toggle buttons) */
QPushButton:checked {
    qproperty-icon: none;
    qproperty-iconSize: 0px;
}

/* Evitar que el sistema operativo intente sobrecargar iconos */
QPushButton::indicator {
    width: 0px;
    height: 0px;
    image: none;
}
