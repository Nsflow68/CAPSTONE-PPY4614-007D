# Configuracion local / desarrollo - Mi Refugio Web
DEBUG=True
SECRET_KEY=replace-with-secure-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Base de datos
# Opciones para DB_ENGINE: sqlite (arranque local sin dependencias externas) | postgresql (Docker/RDS)
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# Parametros PostgreSQL (activos cuando DB_ENGINE=postgresql o via docker-compose)
DB_NAME=mirefugio
DB_USER=mirefugio_user
DB_PASS=mirefugio_local_dev_pass
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
DB_SEARCH_PATH=web,core,public
DB_CONN_MAX_AGE=60

# Seguridad HTTP (en produccion con HTTPS deben estar en True)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# reCAPTCHA (CONTACT_BYPASS_RECAPTCHA=1 habilita pruebas locales sin llaves de Google)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
CONTACT_BYPASS_RECAPTCHA=1

# Transbank Webpay Plus (ambiente sandbox de integracion por defecto)
TBK_ENV=integration
TBK_API_KEY_ID=597055555532
TBK_API_KEY_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TBK_RETURN_URL=http://127.0.0.1:8000/donar/retorno/

# Donaciones
DONATION_MIN_CLP=500

